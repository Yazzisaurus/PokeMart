// Client schema only. Do not run Prisma Migrate.
// Apply SQL files in /migrations with: node migrations/run.mjs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  @@map("users")
}
